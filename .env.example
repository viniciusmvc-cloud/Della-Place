# ========================================
# AUTH (Onda 2.3 - Magic link via email)
# ========================================
# Será preenchido quando configurarmos NextAuth + SMTP da Hostinger
# NEXTAUTH_SECRET=
# NEXTAUTH_URL=https://dellapace.com.br
# EMAIL_SERVER_HOST=smtp.hostinger.com
# EMAIL_SERVER_PORT=587
# EMAIL_SERVER_USER=contato@dellapace.com.br
# EMAIL_SERVER_PASSWORD=
# EMAIL_FROM=contato@dellapace.com.br

# ========================================
# TELEGRAM BOT (Onda 2.4)
# ========================================
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

