# ========================================
# DELLA PACE - Environment Variables
# ========================================
# Copie este arquivo para .env.local e preencha com suas credenciais

# ========================================
# SUPABASE - Database & Auth
# ========================================
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxx
SUPABASE_SERVICE_ROLE_KEY=xxxxx

# ========================================
# TELEGRAM BOT
# ========================================
# Token do bot criado em @BotFather
TELEGRAM_BOT_TOKEN=xxxxx:xxxxx
# ID do chat para onde enviar notificações (ID do Aurélio ou grupo)
TELEGRAM_CHAT_ID=xxxxx

# ========================================
# WhatsApp
# ========================================
# Número do Aurélio (com código do país, sem caracteres especiais)
# Ex: 5521999999999
NEXT_PUBLIC_WHATSAPP_PHONE=55xxxxx
WHATSAPP_BUSINESS_PHONE_ID=xxxxx
WHATSAPP_BUSINESS_ACCOUNT_ID=xxxxx
WHATSAPP_BUSINESS_ACCESS_TOKEN=xxxxx

# ========================================
# PIX
# ========================================
# Chave PIX do Aurélio (email, CPF, telefone ou aleatória)
NEXT_PUBLIC_PIX_KEY=xxxxx@email

# Para integração futura com payment gateway
# PAYMENT_GATEWAY_API_KEY=xxxxx
# PAYMENT_GATEWAY_SECRET=xxxxx

# ========================================
# APLICAÇÃO
# ========================================
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Della Pace - Pizzeria Artigianale

# ========================================
# DOMÍNIO
# ========================================
# Será preenchido quando tiver o domínio de Aurélio
NEXT_PUBLIC_DOMAIN=dellapace.com.br

# ========================================
# MODO DEBUG (desenvolvimento)
# ========================================
DEBUG=true
